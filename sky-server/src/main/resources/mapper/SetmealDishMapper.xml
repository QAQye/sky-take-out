<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--这里的映射已经是映射好了的版本-->
<mapper namespace="com.sky.mapper.SetmealDishMapper">
    <select id="getByDishId" resultType="java.lang.Long">
        select setmeal_id from setmeal_dish where dish_id in
        <foreach collection="ids" item="dish_id" open="(" separator="," close=")">
            #{dish_id}
        </foreach>
    </select>
    <insert id="saveBatch">
        insert into setmeal_dish(setmeal_id, dish_id, name, price, copies) values
        <foreach collection="setmealDishes" item="sd" separator=",">
            (#{sd.setmealId},#{sd.dishId},#{sd.name},#{sd.price},#{sd.copies})
        </foreach>
    </insert>
    <select id="getBySetmealId" resultType="com.sky.entity.SetmealDish">
        select * from setmeal_dish where setmeal_id=#{setmealId}
    </select>
</mapper>
